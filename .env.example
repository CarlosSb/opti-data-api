# ============================================================================
# Exemplo de configuracao organizado por categorias.
# Copie para .env e preencha os valores conforme o ambiente.
# Nunca commite segredos reais.
# ============================================================================

# IA visual
# Chaves e modelo usados para OCR/analise por IA quando o OCR local nao basta.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPEMAI_MODEL e aceito temporariamente como alias legado de OPENAI_MODEL.
# OPEMAI_MODEL=gpt-4o-mini

# Autenticacao da API
# Chave exigida pelos endpoints protegidos via X-API-Key.
API_KEY=

# Webhooks
# URL padrao, assinatura e timeout para callbacks enviados ao Otica Plus.
DEFAULT_WEBHOOK_URL=http://localhost:3000/api/webhooks/optiprocess
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5

# CORS
# Origens autorizadas a chamar a API em ambiente local ou publicado.
CORS_ORIGINS=*

# OCR local
# Limiares do OCR local antes de cair para IA visual.
OCR_MIN_CONFIDENCE=0.75
OCR_MIN_TEXT_LENGTH=15

# Upload e processamento
# Limites operacionais para arquivos enviados para processamento.
MAX_UPLOAD_MB=15
